<h1>KelloggCoin Ledger</h1>

<!-- Step 1: List all transactions, starting with the ICO -->

<%
  transactions = Transaction.all
%>

<h2>Transactions - List Version</h2>
<ul>
  <% for transaction in transactions %>
    <% to_user = User.find_by({ "id" => transaction["to_user_id"] }) %>
     <li> 
      <% if transaction["from_user_id"] == nil then %>
         Intial coin offering: <%= transaction["amount"]%> to <%= to_user["name"]%>
      <% else %>
        <% from_user = User.find_by({ "id" => transaction["from_user_id"] }) %>
        <%= transaction["amount"] %> KC from <%= from_user["name"] %> to <%= to_user["name"] %>
      <% end %>
    </li>
  <% end %>
</ul>

<h2>Transactions - Table Version</h2>

  <table>
    <tr>
      <th>From User</th>
      <th>To User</th>
      <th>Amount</th>
    </tr>
  <% for transaction in transactions %>
    <% to_user = User.find_by({ "id" => transaction["to_user_id"] }) %>
    <tr>
      <td>  <% if transaction["from_user_id"] == nil then %>
              Intial coin offering
            <% else %>    
              <% from_user = User.find_by({ "id" => transaction["from_user_id"] }) %>
              <%= from_user["name"] %> 
              <% end %>
      </td>
      <td><%= to_user["name"] %> </td>
      <td><%= transaction["amount"] %> </td>
    </tr>
  <% end %>
</table>

<!-- Step 2: Calculate and display the balances -->

<h2>Balances - List Version</h2>

<%
  users = User.all
%>

</ul>
  <% for user in users %>
    <% balance = Transaction.where({ "to_user_id" => user["id"] }).sum("amount") - 
                 Transaction.where({ "from_user_id" => user["id"] }).sum("amount")  %>
    <li> 
      Balance for <%= user["name"] %>: <%= balance %>
    </li> 
  <% end %> 
</ul>

<h2>Balances - Table Version</h2>


<table>
  <tr>
    <th>User</th>
    <th>Balance</th>
  </tr>
  <% for user in users %>
    <% balance = Transaction.where({ "to_user_id" => user["id"] }).sum("amount") - 
                 Transaction.where({ "from_user_id" => user["id"] }).sum("amount")  %>
    <tr> 
      <td><%= user["name"] %></td>
      <td><%= balance %></td>
    </tr> 
  <% end %> 
</table>
